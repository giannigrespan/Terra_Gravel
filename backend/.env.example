# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=terragravel
DB_SSL=false

# For Production (Neon or other cloud PostgreSQL)
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
SWIPE_RATE_LIMIT_MAX=200
FEEDBACK_RATE_LIMIT_MAX=10

# File Upload
MAX_FILE_SIZE=5242880

# Location Privacy
LOCATION_PRECISION=0.01

# Matching Algorithm
DEFAULT_MAX_DISTANCE_KM=20
MAX_STACK_SIZE=50

# ======================
# Email Configuration
# ======================
# Choose provider: smtp, sendgrid, or ses
EMAIL_PROVIDER=smtp
EMAIL_FROM=TerraGravel <noreply@terragravel.app>

# SMTP (Gmail, Outlook, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SendGrid (alternative)
# SENDGRID_API_KEY=SG.xxxxx

# AWS SES (alternative)
# AWS_SES_HOST=email-smtp.eu-central-1.amazonaws.com
# AWS_SES_USER=your-ses-user
# AWS_SES_PASS=your-ses-pass

# ======================
# Firebase Configuration (Push Notifications)
# ======================
# Option 1: Service account JSON (recommended)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Option 2: Individual credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ======================
# App Configuration
# ======================
APP_URL=https://terragravel.app

# ======================
# Google OAuth
# ======================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id
GOOGLE_IOS_CLIENT_ID=your-ios-client-id

# ======================
# Strava OAuth
# ======================
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
